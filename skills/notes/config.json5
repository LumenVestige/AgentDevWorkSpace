// Note 配置。init.sh（由 setup.sh 调用）首次接入时复制到项目的 agent-workspace/config/notes.json5，之后不覆盖。
// 缺少的字段取 agent-workspace/skills/common/notes/config.json5（本文件的原始版本）的默认值，可以只保留需要修改的字段。
{
  // Note 开关。false 时 verify.py 不触发 Note，也不按上限合并。
  enabled: true,
  // 每个日期目录（notes/<类型>/<YYYY-MM-DD>/）的 Note 上限。超出时 verify.py 把最早的几条合并为一条，使数量回到上限，内容不删除。
  max_notes: 100,
  // 自动更新开关。true 时 update.py 在展示欢迎语（SessionStart hook 和 Codex 启动入口 codex.sh）和检查到期时（Stop hook）比较版本号：
  // 本地 AgentDevWorkSpace 的 publish/version 低于远端时，立即在后台拉取（git pull --ff-only）并执行 setup.sh。
  auto_update: true,
  // 每轮结束时（Stop hook）版本检查的间隔（小时）；展示欢迎语时每次都检查。距上次检查（agent-workspace/.agent/env/last-update）超过该时长即到期。
  auto_update_interval_hours: 24,
  // 远端版本号：versions 库中的 AgentDevWorkSpace/version（https://github.com/LumenVestige/versions/blob/main/AgentDevWorkSpace/version）。
  // 默认用 GitHub API 读取，发布后立即可见；失败时回退到 raw.githubusercontent.com（有约 5 分钟 CDN 缓存）。
  update_url: "https://api.github.com/repos/LumenVestige/versions/contents/AgentDevWorkSpace/version?ref=main",
  // 触发 Note 的扫描规则（verify.py 判断是否触发、create.py 填入提交时共用）。
  scan: {
    // 基线之后存在未记录到任何 Note 的提交时触发。false 时不按提交触发。
    commits: true,
    // 是否计入 merge 提交。
    include_merges: false,
    // 只统计改动了这些路径的提交（git pathspec，相对项目根目录），空数组表示全部，例如 ["src", "lib"]。
    paths: [],
    // 不统计只改动了这些路径的提交（git pathspec），例如 ["docs", "*.md"]。
    exclude_paths: [],
    // 工作区大规模改动：未提交的改动（含未跟踪文件，同样按 paths / exclude_paths 过滤）相对上次记录新增的
    // 文件数达到 files 或行数（增 + 删）达到 lines 时，触发 large-scale-file-change Note。
    large_change: {
      enabled: true,
      files: 20,
      lines: 1000,
    },
  },
}
